        CountPlayerGarageVehicles(playerid),
        MAX_GARAGE_SLOTS,
        OwnedVehicleSlot[playerid] == -1 ? 0 : OwnedVehicleSlot[playerid] + 1
    );

    format(dialogText, sizeof(dialogText), "%s", header);

