+stock RefreshStoredOwnedVehicleRuntime(playerid)
+{
+    if (!IsPlayerConnected(playerid) || !PlayerLoggedIn[playerid]) return 0;
+    new streamed = 0;
+    for (new slotIndex = 0; slotIndex < MAX_GARAGE_SLOTS; slotIndex++)
+    {
+        if (PlayerGarageDBID[playerid][slotIndex] <= 0 || !PlayerGarageStored[playerid][slotIndex])
+        {
+            DestroyStoredOwnedVehicleRuntime(playerid, slotIndex);
+            continue;
+        }
+        new locationIndex = GetVehicleStorageLocationIndexByID(PlayerGarageStorageLocationID[playerid][slotIndex]);
+        if (locationIndex == -1 || GetPlayerInterior(playerid) != VehicleStorageInterior[locationIndex] || GetPlayerVirtualWorld(playerid) != VehicleStorageVirtualWorld[locationIndex])
+        {
+            DestroyStoredOwnedVehicleRuntime(playerid, slotIndex);
+            continue;
+        }
+        new Float:distance = GetPlayerDistanceFromPoint(playerid, PlayerGarageX[playerid][slotIndex], PlayerGarageY[playerid][slotIndex], PlayerGarageZ[playerid][slotIndex]);
+        if (distance > STORED_OWNED_VEHICLE_STREAM_OUT)
+        {
+            DestroyStoredOwnedVehicleRuntime(playerid, slotIndex);
+            continue;
+        }
+        if (distance <= STORED_OWNED_VEHICLE_STREAM_IN && streamed < STORED_OWNED_VEHICLE_STREAM_LIMIT)
+        {
+            streamed++;
+            if (PlayerGarageParkedRuntimeID[playerid][slotIndex] != INVALID_VEHICLE_ID && !IsValidVehicle(PlayerGarageParkedRuntimeID[playerid][slotIndex]))
+            {
+                PlayerGarageParkedRuntimeID[playerid][slotIndex] = INVALID_VEHICLE_ID;
+            }
+            if (PlayerGarageParkedRuntimeID[playerid][slotIndex] == INVALID_VEHICLE_ID)
+            {
+                new vehicleid = CreateVehicle(PlayerGarageModel[playerid][slotIndex],PlayerGarageX[playerid][slotIndex],PlayerGarageY[playerid][slotIndex],PlayerGarageZ[playerid][slotIndex],PlayerGarageA[playerid][slotIndex],PlayerGarageColor1[playerid][slotIndex],PlayerGarageColor2[playerid][slotIndex],-1);
+                if (vehicleid != INVALID_VEHICLE_ID)
+                {
+                    PlayerGarageParkedRuntimeID[playerid][slotIndex] = vehicleid;
+                    LinkVehicleToInterior(vehicleid, VehicleStorageInterior[locationIndex]);
+                    SetVehicleVirtualWorld(vehicleid, VehicleStorageVirtualWorld[locationIndex]);
+                    SetVehicleHealth(vehicleid, PlayerGarageHealth[playerid][slotIndex]);
+                    SetVehicleParamsEx(vehicleid,0,0,0,1,0,0,0);
+                }
+            }
+        }
+    }
+    return 1;
+}
