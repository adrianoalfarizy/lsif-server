        strcat(dialogText, line, sizeof(dialogText));
    }

    ShowPlayerDialog(playerid, DIALOG_WPICKUP_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Select World Pickup", dialogText, "Select", "Back");
    return 1;
}

