+stock ShowHouseVehicleStoreConfirm(playerid, locationIndex)
+{
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount) return 0;
+    new slotIndex = OwnedVehicleSlot[playerid];
+    if (!IsValidGarageSlot(slotIndex) || PlayerGarageDBID[playerid][slotIndex] <= 0) return 0;
+
+    PlayerDialogHouseStorageLocationIndex[playerid] = locationIndex;
+    new body[512];
