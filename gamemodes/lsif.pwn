stock ShowGarageRepairConfirmDialog(playerid)
{
    if (OwnedVehicleID[playerid] == INVALID_VEHICLE_ID || OwnedVehicleSlot[playerid] == -1)
    {
        SendClientMessage(playerid, COLOR_RED, "Tidak ada kendaraan aktif yang sedang spawn.");
