+                "UPDATE player_vehicle_storage SET storage_status='destroyed_cooldown' WHERE player_vehicle_id=%d AND owner_player_id=%d LIMIT 1",
+                OwnedVehicleDBID[playerid],PlayerDBID[playerid]);
+            mysql_tquery(g_SQL, query);
+            SendClientMessage(playerid, COLOR_RED, "Owned vehicle hancur. Setelah cooldown kendaraan kembali ke home garage.");
+        }
+        else
+        {
+            OwnedVehicleLifecycle[playerid] = OWNED_VEHICLE_STATE_DEALER_PENDING;
+            if (IsValidGarageSlot(OwnedVehicleSlot[playerid])) PlayerGarageLifecycle[playerid][OwnedVehicleSlot[playerid]] = OWNED_VEHICLE_STATE_DEALER_PENDING;
+            mysql_format(g_SQL, query, sizeof(query),
+                "UPDATE player_vehicles SET lifecycle_status='dealer_pending',lifecycle_source_tag='saif_owned_vehicle_rework_v0.26A.1.31',destroyed_until=NULL,last_state_changed_at=NOW() WHERE id=%d AND owner_id=%d LIMIT 1",
+                OwnedVehicleDBID[playerid],PlayerDBID[playerid]);
+            mysql_tquery(g_SQL, query);
+            SendClientMessage(playerid, COLOR_RED, "Kendaraan dealer_pending hancur dan kembali ke delivery queue dealership.");
+        }
+        break;
+    }
+    return 1;
