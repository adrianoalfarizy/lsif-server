{
    HideClassSelectionForAuth(playerid);
    PlayerAuthDialogShown[playerid] = 1;
    ShowPlayerDialog(
        playerid,
        DIALOG_LOGIN,
        DIALOG_STYLE_PASSWORD,
        "LSIF Login",
