+stock SaveGlobalParkingPointAtPlayer(playerid, const pointName[])
+{
+    if (!IsAdminLevel(playerid, ADMIN_OWNER)) return 0;
+    new nameLength = strlen(pointName);
+    if (nameLength < 3 || nameLength > 63)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Nama parking point harus 3 sampai 63 karakter.");
+        return 0;
+    }
+
+    new Float:x, Float:y, Float:z, Float:a;
+    new vehicleid = GetPlayerVehicleID(playerid);
+    if (GetPlayerState(playerid) == PLAYER_STATE_DRIVER && vehicleid != INVALID_VEHICLE_ID && IsValidVehicle(vehicleid))
+    {
+        GetVehiclePos(vehicleid, x, y, z);
+        GetVehicleZAngle(vehicleid, a);
+    }
+    else
+    {
+        GetPlayerPos(playerid, x, y, z);
+        GetPlayerFacingAngle(playerid, a);
+    }
+
+    new query[1024];
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO vehicle_spawn_points (point_key,point_name,source_type,source_reference_id,pos_x,pos_y,pos_z,pos_a,interior_id,virtual_world,clear_radius,priority,enabled,source_tag) VALUES (CONCAT('admin_',SHA1(CONCAT(%d,'-',UNIX_TIMESTAMP(NOW(6)),'-',RAND()))),'%e','admin_custom',NULL,%f,%f,%f,%f,%d,%d,4.5,20,1,'saif_global_parking_admin_v0.26A.1.31.5')",
+        PlayerDBID[playerid], pointName, x, y, z, a, GetPlayerInterior(playerid), GetPlayerVirtualWorld(playerid));
+    mysql_tquery(g_SQL, query, "OnGlobalParkingPointSaved", "i", playerid);
+    return 1;
+}
+
+public OnGlobalParkingPointSaved(playerid)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Parking point gagal disimpan. Periksa log database.");
+        return 1;
+    }
+    LoadOwnedVehicleSpawnPoints();
+    SendClientMessage(playerid, COLOR_GREEN, "Global parking point disimpan dan runtime direload.");
+    return 1;
+}
+
+stock DisableGlobalParkingPoint(playerid, pointid)
+{
+    if (!IsAdminLevel(playerid, ADMIN_OWNER)) return 0;
+    if (pointid <= 0)
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Usage: /parkingpointdisable [id]");
+        return 0;
+    }
+    new query[384];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE vehicle_spawn_points SET enabled=0 WHERE id=%d AND source_type='admin_custom' LIMIT 1", pointid);
+    mysql_tquery(g_SQL, query, "OnGlobalParkingPointDisabled", "ii", playerid, pointid);
+    return 1;
+}
+
+public OnGlobalParkingPointDisabled(playerid, pointid)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "ID tidak ditemukan atau bukan admin_custom parking point.");
+        return 1;
