        new idStr[16];

        if (!GetOneParam(cmdtext[13], idStr, sizeof(idStr)) || !IsNumericString(idStr))
        {
            SendClientMessage(playerid, COLOR_YELLOW, "Gunakan: /parkvehinfo [id]");
