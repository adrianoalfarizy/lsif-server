    PlayerEditingBusinessPresetIndex[playerid] = businessIndex;
    ShowPlayerDialog(playerid, DIALOG_BUSINESS_PRESET_INFO, DIALOG_STYLE_MSGBOX, "Business Preset Info", body, "Back", "Close");
