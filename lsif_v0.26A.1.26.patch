+stock QueryOfflineGarageSummary(playerid)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+
+    new query[2600];
+    query[0] = EOS;
+    strcat(query, "SELECT s.id,s.status,s.total_garages,s.linked_garages,s.linked_house_plans,s.baseline_house_links,s.story_asset_links,s.unlinked_garages,s.service_garages,s.world_reference_garages,s.invalid_bounds,", sizeof(query));
+    strcat(query, "(SELECT COUNT(*) FROM offline_garage_canonical_plan p WHERE p.resolver_session_id=s.id AND p.enabled<>0) enabled_rows,", sizeof(query));
+    strcat(query, "(SELECT COUNT(*) FROM offline_garage_canonical_plan p WHERE p.resolver_session_id=s.id AND p.apply_status<>'draft') nondraft_rows,", sizeof(query));
+    strcat(query, "(SELECT COUNT(*) FROM offline_property_source_queue q WHERE q.session_id=s.source_session_id AND q.evidence_type='garage_reference') source_garages ", sizeof(query));
+    strcat(query, "FROM offline_garage_resolver_sessions s WHERE BINARY s.resolver_version=BINARY 'saif-garage-canonical-resolver-v0.26A.1.26' ORDER BY s.id DESC LIMIT 1", sizeof(query));
+    mysql_tquery(g_SQL, query, "OnOfflineGarageSummaryLoaded", "i", playerid);
+    return 1;
+}
+
+public OnOfflineGarageSummaryLoaded(playerid)
+{
+    if (!IsPlayerConnected(playerid) || !IsAdminLevel(playerid, ADMIN_OWNER)) return 1;
+    if (cache_num_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Garage canonical queue belum tersedia. Jalankan migration + resolver v0.26A.1.26.");
+        return ShowOfflineImportAuditMenu(playerid);
+    }
+
+    new sessionid, total, linkedGarages, linkedHousePlans, baselineLinks, storyLinks, unlinked, services, worldRefs, invalidBounds, enabledRows, nondraftRows, sourceGarages;
+    new status[24];
+    cache_get_value_name_int(0, "id", sessionid);
+    cache_get_value_name_int(0, "total_garages", total);
+    cache_get_value_name_int(0, "linked_garages", linkedGarages);
+    cache_get_value_name_int(0, "linked_house_plans", linkedHousePlans);
+    cache_get_value_name_int(0, "baseline_house_links", baselineLinks);
+    cache_get_value_name_int(0, "story_asset_links", storyLinks);
+    cache_get_value_name_int(0, "unlinked_garages", unlinked);
+    cache_get_value_name_int(0, "service_garages", services);
+    cache_get_value_name_int(0, "world_reference_garages", worldRefs);
+    cache_get_value_name_int(0, "invalid_bounds", invalidBounds);
+    cache_get_value_name_int(0, "enabled_rows", enabledRows);
+    cache_get_value_name_int(0, "nondraft_rows", nondraftRows);
+    cache_get_value_name_int(0, "source_garages", sourceGarages);
+    cache_get_value_name(0, "status", status, sizeof(status));
+
+    new body[2600];
+    format(body, sizeof(body),
+        "GTA SA Garage Offline Canonical Queue v0.26A.1.26\n\nSession: %d\nStatus: %s\nExact GRGE source: %d / 52\nCanonical garage rows: %d / 52\n\nHouse linkage\nLinked garage definitions: %d\nLinked house plans: %d / 13\nBaseline savehouse links: %d / 12\nStory/deferred links: %d / 1\nUnlinked garage definitions: %d\n\nClassification\nPay 'n' Spray / vehicle mod services: %d\nWorld / special garage references: %d\nInvalid bounds: %d (must be 0)\n\nSafety\nEnabled rows: %d (must be 0)\nNon-draft apply rows: %d (must be 0)\nRuntime doors/checkpoints/ownership: none\n\nBrowse untuk memeriksa exact source, bounds, garage type, door type, klasifikasi, dan hubungan ke canonical house plan.",
+        sessionid, status, sourceGarages, total, linkedGarages, linkedHousePlans, baselineLinks, storyLinks, unlinked, services, worldRefs, invalidBounds, enabledRows, nondraftRows);
+    ShowPlayerDialog(playerid, DIALOG_OFFLINE_GARAGE_SUMMARY, DIALOG_STYLE_MSGBOX,
+                     "GTA SA Garage Canonical Queue", body, "Browse", "Back");
+    return 1;
+}
