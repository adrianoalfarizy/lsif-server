+stock QueryGarageGeometryList(playerid, page = 0)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+    if (page < 0) page = 0;
+
+    PlayerGarageGeometryPage[playerid] = page;
+    PlayerGarageGeometryListCount[playerid] = 0;
+
+    new query[1500];
+    mysql_format(g_SQL, query, sizeof(query),
+        "SELECT g.id,g.garage_name,g.safety_class,g.geometry_status,g.front_width,g.depth_length,g.height_clearance,COALESCE((SELECT GROUP_CONCAT(l.house_slot ORDER BY l.house_slot SEPARATOR ',') FROM offline_garage_house_links l JOIN offline_garage_geometry_sessions s ON s.garage_resolver_session_id=l.resolver_session_id WHERE s.id=g.geometry_session_id AND l.garage_plan_id=g.garage_plan_id),'') house_slots FROM offline_garage_geometry_plan g WHERE g.geometry_session_id=(SELECT id FROM offline_garage_geometry_sessions WHERE BINARY planner_version=BINARY '%e' ORDER BY id DESC LIMIT 1) ORDER BY FIELD(g.safety_class,'baseline_savehouse_candidate','story_asset_deferred','service_reference','world_reference'),g.garage_name,g.id LIMIT %d,%d",
+        "saif-garage-geometry-planner-v0.26A.1.28", page * GARAGE_GEOMETRY_PAGE_SIZE, GARAGE_GEOMETRY_PAGE_SIZE + 1);
+    mysql_tquery(g_SQL, query, "OnGarageGeometryListLoaded", "ii", playerid, page);
+    return 1;
+}
+
+public OnGarageGeometryListLoaded(playerid, page)
+{
+    if (!IsPlayerConnected(playerid) || !IsAdminLevel(playerid, ADMIN_OWNER)) return 1;
+
+    new rows;
+    cache_get_row_count(rows);
+    PlayerGarageGeometryPage[playerid] = page;
+    PlayerGarageGeometryListCount[playerid] = 0;
+
+    new body[6000];
+    body[0] = EOS;
+    strcat(body, "Garage / House Slot\tStatus\tWidth / Depth / Height\n", sizeof(body));
+
+    if (page > 0)
+    {
+        PlayerGarageGeometryListDBID[playerid][PlayerGarageGeometryListCount[playerid]++] = -1;
+        strcat(body, "<< Previous Page\tNavigation\t\n", sizeof(body));
+    }
+
+    new dataRows = rows;
+    if (dataRows > GARAGE_GEOMETRY_PAGE_SIZE) dataRows = GARAGE_GEOMETRY_PAGE_SIZE;
+    for (new i = 0; i < dataRows; i++)
+    {
+        new id;
+        new Float:width, Float:depth, Float:height;
+        new name[40], safety[48], status[32], slots[128], line[320];
+        cache_get_value_name_int(i, "id", id);
+        cache_get_value_name_float(i, "front_width", width);
+        cache_get_value_name_float(i, "depth_length", depth);
+        cache_get_value_name_float(i, "height_clearance", height);
+        cache_get_value_name(i, "garage_name", name, sizeof(name));
+        cache_get_value_name(i, "safety_class", safety, sizeof(safety));
+        cache_get_value_name(i, "geometry_status", status, sizeof(status));
+        cache_get_value_name(i, "house_slots", slots, sizeof(slots));
+
+        PlayerGarageGeometryListDBID[playerid][PlayerGarageGeometryListCount[playerid]++] = id;
+        if (slots[0] == EOS) format(slots, sizeof(slots), "-");
+        format(line, sizeof(line), "#%d %s / %s\t%s / %s\t%.2f / %.2f / %.2f\n", id, name, slots, status, safety, width, depth, height);
+        strcat(body, line, sizeof(body));
+    }
+
+    if (rows > GARAGE_GEOMETRY_PAGE_SIZE && PlayerGarageGeometryListCount[playerid] < MAX_GARAGE_GEOMETRY_DIALOG_ROWS)
+    {
+        PlayerGarageGeometryListDBID[playerid][PlayerGarageGeometryListCount[playerid]++] = -2;
+        strcat(body, ">> Next Page\tNavigation\t\n", sizeof(body));
+    }
+
+    if (dataRows == 0 && page == 0) strcat(body, "No rows\tRun planner SQL v0.26A.1.28\tRead-only\n", sizeof(body));
+    ShowPlayerDialog(playerid, DIALOG_GARAGE_GEOMETRY_LIST, DIALOG_STYLE_TABLIST_HEADERS,
+                     "Garage Geometry Plans", body, "Detail", "Back");
+    return 1;
+}
+
+stock QueryGarageGeometryDetail(playerid, geometryid)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+    if (geometryid <= 0) return QueryGarageGeometryList(playerid, PlayerGarageGeometryPage[playerid]);
+
+    new query[2600];
+    mysql_format(g_SQL, query, sizeof(query),
+        "SELECT g.*,p.garage_type,p.garage_door_type,p.source_file,p.source_line,COALESCE((SELECT GROUP_CONCAT(CONCAT('Slot ',l.house_slot,' - ',l.house_display_name) ORDER BY l.house_slot SEPARATOR '\\n') FROM offline_garage_house_links l JOIN offline_garage_geometry_sessions s ON s.garage_resolver_session_id=l.resolver_session_id WHERE s.id=g.geometry_session_id AND l.garage_plan_id=g.garage_plan_id),'None') house_links FROM offline_garage_geometry_plan g JOIN offline_garage_canonical_plan p ON p.id=g.garage_plan_id WHERE g.id=%d AND g.geometry_session_id=(SELECT id FROM offline_garage_geometry_sessions WHERE BINARY planner_version=BINARY '%e' ORDER BY id DESC LIMIT 1) LIMIT 1",
+        geometryid, "saif-garage-geometry-planner-v0.26A.1.28");
+    mysql_tquery(g_SQL, query, "OnGarageGeometryDetailLoaded", "ii", playerid, geometryid);
+    return 1;
+}
