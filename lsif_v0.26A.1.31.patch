+stock ProcessOwnedVehicleDespawn(playerid)
+{
+    if (!VehicleStorageDespawnEnabled)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Fitur /despawn sedang dinonaktifkan oleh policy.");
+        return 0;
+    }
+    if (OwnedVehicleID[playerid] == INVALID_VEHICLE_ID || OwnedVehicleDBID[playerid] <= 0 || OwnedVehicleSlot[playerid] < 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Tidak ada owned vehicle aktif.");
+        return 0;
+    }
+    if (OwnedVehicleHomeStorageLocationID[playerid] <= 0 || OwnedVehicleHomeStorageSlot[playerid] <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kendaraan ini belum pernah disimpan di garage. /despawn ditolak.");
+        return 0;
+    }
+    if (HasOtherPlayerInVehicle(playerid, OwnedVehicleID[playerid]))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Turunkan semua penumpang sebelum /despawn.");
+        return 0;
+    }
+
+    new slotIndex = OwnedVehicleSlot[playerid];
+    new Float:health,Float:homeX,Float:homeY,Float:homeZ,Float:homeA;
+    GetVehicleHealth(OwnedVehicleID[playerid], health);
+    if (!GetOwnedVehicleHomeTransform(playerid,homeX,homeY,homeZ,homeA))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Transform home garage tidak ditemukan. /despawn dibatalkan.");
+        return 0;
+    }
+    OwnedVehicleHealth[playerid] = health;
+    ResetOwnedVehiclePendingModification(playerid);
+    PlayerGarageX[playerid][slotIndex]=homeX;
+    PlayerGarageY[playerid][slotIndex]=homeY;
+    PlayerGarageZ[playerid][slotIndex]=homeZ;
+    PlayerGarageA[playerid][slotIndex]=homeA;
+    new query[1536];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE player_vehicles SET lifecycle_status='stored',lifecycle_source_tag='saif_owned_vehicle_rework_v0.26A.1.31',pos_x=%f,pos_y=%f,pos_z=%f,pos_a=%f,health=%f,fuel=%d,locked=%d,destroyed_until=NULL,last_state_changed_at=NOW() WHERE id=%d AND owner_id=%d LIMIT 1",
+        homeX,homeY,homeZ,homeA,health,OwnedVehicleFuel[playerid],OwnedVehicleLocked[playerid],OwnedVehicleDBID[playerid],PlayerDBID[playerid]);
+    mysql_tquery(g_SQL, query, "OnOwnedVehicleDespawned", "ii", playerid, slotIndex);
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO player_vehicle_storage (player_vehicle_id,owner_player_id,storage_location_id,storage_slot,storage_status,stored_health,stored_fuel,stored_locked,transaction_token,source_tag) VALUES (%d,%d,%d,%d,'stored',%f,%d,%d,SHA1(CONCAT('despawn-',%d,'-',UNIX_TIMESTAMP(NOW(6)))),'saif_owned_vehicle_rework_v0.26A.1.31') ON DUPLICATE KEY UPDATE storage_location_id=VALUES(storage_location_id),storage_slot=VALUES(storage_slot),storage_status='stored',stored_health=VALUES(stored_health),stored_fuel=VALUES(stored_fuel),stored_locked=VALUES(stored_locked),stored_at=NOW(),released_at=NULL,source_tag=VALUES(source_tag)",
+        OwnedVehicleDBID[playerid],PlayerDBID[playerid],OwnedVehicleHomeStorageLocationID[playerid],OwnedVehicleHomeStorageSlot[playerid],health,OwnedVehicleFuel[playerid],OwnedVehicleLocked[playerid],OwnedVehicleDBID[playerid]);
+    mysql_tquery(g_SQL, query);
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO vehicle_storage_transactions (transaction_token,action_type,status,player_vehicle_id,owner_player_id,to_storage_location_id,storage_slot,vehicle_health,vehicle_fuel,vehicle_locked,source_tag,completed_at) VALUES (SHA1(CONCAT('despawn-tx-',%d,'-',UNIX_TIMESTAMP(NOW(6)))),'despawn','complete',%d,%d,%d,%d,%f,%d,%d,'saif_owned_vehicle_rework_v0.26A.1.31',NOW())",
+        OwnedVehicleDBID[playerid],OwnedVehicleDBID[playerid],PlayerDBID[playerid],OwnedVehicleHomeStorageLocationID[playerid],OwnedVehicleHomeStorageSlot[playerid],health,OwnedVehicleFuel[playerid],OwnedVehicleLocked[playerid]);
+    mysql_tquery(g_SQL, query);
+    return 1;
+}
+
+public OnOwnedVehicleDespawned(playerid, slotIndex)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Gagal mengembalikan lifecycle kendaraan ke garage.");
+        return 1;
+    }
+    if (OwnedVehicleID[playerid] != INVALID_VEHICLE_ID)
+    {
+        if (IsPlayerInVehicle(playerid, OwnedVehicleID[playerid])) RemovePlayerFromVehicle(playerid);
+        DestroyOwnedVehicleLabel(playerid);
+        DestroyVehicle(OwnedVehicleID[playerid]);
+        OwnedVehicleID[playerid] = INVALID_VEHICLE_ID;
+    }
+    PlayerGarageStored[playerid][slotIndex] = 1;
+    PlayerGarageLifecycle[playerid][slotIndex] = OWNED_VEHICLE_STATE_STORED;
+    OwnedVehicleLifecycle[playerid] = OWNED_VEHICLE_STATE_STORED;
+    SendClientMessage(playerid, COLOR_GREEN, "Kendaraan aktif di-despawn dan kembali ke posisi default garage.");
+    return 1;
+}
