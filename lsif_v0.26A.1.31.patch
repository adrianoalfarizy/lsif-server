+stock ProcessOwnedVehicleSpawnRequest(playerid, slotIndex)
+{
+    if (!IsValidGarageSlot(slotIndex) || PlayerGarageDBID[playerid][slotIndex] <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Nomor kendaraan tidak valid.");
+        return 0;
+    }
+    if (OwnedVehicleID[playerid] != INVALID_VEHICLE_ID)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Masih ada owned vehicle aktif. Gunakan /despawn terlebih dahulu.");
+        return 0;
+    }
+    if (PlayerGarageDestroyedCooldownSeconds[playerid][slotIndex] > 0)
+    {
+        new msg[144];
+        format(msg, sizeof(msg), "Kendaraan masih dalam cooldown perbaikan selama %d detik.", PlayerGarageDestroyedCooldownSeconds[playerid][slotIndex]);
+        SendClientMessage(playerid, COLOR_RED, msg);
+        return 0;
+    }
+    if (PlayerGarageLifecycle[playerid][slotIndex] == OWNED_VEHICLE_STATE_DEALER_PENDING && !IsPlayerNearDealership(playerid))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kendaraan dealer_pending hanya dapat diambil ulang di dealership.");
+        return 0;
+    }
+
+    new Float:x, Float:y, Float:z, Float:a;
+    if (PlayerGarageLifecycle[playerid][slotIndex] == OWNED_VEHICLE_STATE_DEALER_PENDING)
+    {
+        GetPlayerPos(playerid, x, y, z);
+        GetPlayerFacingAngle(playerid, a);
+        x += 4.0;
+    }
+    else
+    {
+        if (!VehicleStorageNearestSpawnEnabled || !FindNearestOwnedVehicleSpawn(playerid, x, y, z, a))
+        {
+            SendClientMessage(playerid, COLOR_RED, "Tidak ada titik parkir kosong di dekat posisi aktifmu.");
+            return 0;
+        }
+    }
+
+    DestroyStoredOwnedVehicleRuntime(playerid, slotIndex);
+    PlayerGarageX[playerid][slotIndex] = x;
+    PlayerGarageY[playerid][slotIndex] = y;
+    PlayerGarageZ[playerid][slotIndex] = z;
+    PlayerGarageA[playerid][slotIndex] = a;
+    PlayerGarageStored[playerid][slotIndex] = 0;
+    PlayerGarageLifecycle[playerid][slotIndex] = OWNED_VEHICLE_STATE_ACTIVE;
+    SetActiveVehicleFromGarage(playerid, slotIndex);
+    if (!SpawnOwnedVehicle(playerid)) return 0;
+
+    new query[1024];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE player_vehicles SET lifecycle_status='active',lifecycle_source_tag='saif_owned_vehicle_rework_v0.26A.1.31',pos_x=%f,pos_y=%f,pos_z=%f,pos_a=%f,destroyed_until=NULL,last_state_changed_at=NOW() WHERE id=%d AND owner_id=%d LIMIT 1",
+        x,y,z,a,OwnedVehicleDBID[playerid],PlayerDBID[playerid]);
+    mysql_tquery(g_SQL, query, "OnOwnedVehicleRemoteSpawned", "ii", playerid, slotIndex);
+    if (OwnedVehicleHomeStorageLocationID[playerid] > 0)
+    {
+        mysql_format(g_SQL, query, sizeof(query),
+            "UPDATE player_vehicle_storage SET storage_status='active',released_at=NOW() WHERE player_vehicle_id=%d AND owner_player_id=%d LIMIT 1",
+            OwnedVehicleDBID[playerid],PlayerDBID[playerid]);
+        mysql_tquery(g_SQL, query);
+    }
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO vehicle_storage_transactions (transaction_token,action_type,status,player_vehicle_id,owner_player_id,from_storage_location_id,storage_slot,vehicle_health,vehicle_fuel,vehicle_locked,source_tag,completed_at) VALUES (SHA1(CONCAT('spawn-tx-',%d,'-',UNIX_TIMESTAMP(NOW(6)))),'remote_spawn','complete',%d,%d,NULLIF(%d,0),NULLIF(%d,0),%f,%d,%d,'saif_owned_vehicle_rework_v0.26A.1.31',NOW())",
+        OwnedVehicleDBID[playerid],OwnedVehicleDBID[playerid],PlayerDBID[playerid],OwnedVehicleHomeStorageLocationID[playerid],OwnedVehicleHomeStorageSlot[playerid],OwnedVehicleHealth[playerid],OwnedVehicleFuel[playerid],OwnedVehicleLocked[playerid]);
+    mysql_tquery(g_SQL, query);
+    return 1;
+}
