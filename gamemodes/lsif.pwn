    }

    if (!strcmp(cmdtext, "/parkvehexactinfo", true))
    {
        ShowExactOfflineParkedVehicleImportInfo(playerid);
        return 1;
    }

    if (strfind(cmdtext, "/parkvehrotate ", true) == 0)
    {
        new params[128];
        new idStr[24];
        new angleStr[24];
