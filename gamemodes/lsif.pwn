            SendClientMessage(playerid, COLOR_RED, "Target tidak online/login.");
            return 1;
        }

        new wanted = ClampWantedLevelValue(GetPlayerWantedLevel(targetid) + amount);
        ApplyAdminWantedTool(playerid, targetid, wanted, "WANTED_ADMIN_ADD", "add");
        return 1;
    }

