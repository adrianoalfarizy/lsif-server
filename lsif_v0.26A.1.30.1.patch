+stock ResetPlayerHouseVehicleStorageRuntime(playerid)
+{
+    PlayerHouseStorageCheckpoint[playerid] = 0;
+    PlayerHouseStorageLocationIndex[playerid] = -1;
+    PlayerHouseStorageLastHintTick[playerid] = 0;
+    PlayerDialogHouseStorageLocationIndex[playerid] = -1;
+    PlayerHouseStorageRetrieveCount[playerid] = 0;
+    PlayerHouseStorageEditHouseIndex[playerid] = -1;
+    PlayerPendingHouseStorageLocationIndex[playerid] = -1;
+    PlayerPendingHouseStorageVehicleSlot[playerid] = -1;
+    PlayerPendingHouseStorageDBSlot[playerid] = 0;
+    PlayerPendingHouseStorageVehicleID[playerid] = INVALID_VEHICLE_ID;
+    PlayerHouseStorageOperationPending[playerid] = 0;
+    PlayerPendingHouseStorageToken[playerid][0] = EOS;
+    PlayerPendingHouseStorageHealth[playerid] = 1000.0;
+    PlayerPendingHouseStorageFuel[playerid] = VEHICLE_MAX_FUEL;
+    PlayerPendingHouseStorageLocked[playerid] = 0;
+    for (new i = 0; i < MAX_GARAGE_SLOTS; i++) PlayerHouseStorageRetrieveSlotMap[playerid][i] = -1;
