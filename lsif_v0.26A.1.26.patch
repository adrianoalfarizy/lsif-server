+stock QueryOfflineGarageDetail(playerid, garageid)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+    if (garageid <= 0) return QueryOfflineGarageList(playerid, PlayerOfflineGaragePage[playerid]);
+
+    new query[2600];
+    mysql_format(g_SQL, query, sizeof(query),
+        "SELECT p.*,COALESCE((SELECT GROUP_CONCAT(CONCAT('Slot ',l.house_slot,' - ',l.house_display_name,' [',l.house_decision_code,'] / ',ROUND(l.garage_distance,2),'m') ORDER BY l.house_slot SEPARATOR '\\n') FROM offline_garage_house_links l WHERE l.resolver_session_id=p.resolver_session_id AND l.garage_plan_id=p.id),'None') house_links FROM offline_garage_canonical_plan p WHERE p.id=%d AND BINARY p.resolver_version=BINARY '%e' LIMIT 1",
+        garageid, "saif-garage-canonical-resolver-v0.26A.1.26");
+    mysql_tquery(g_SQL, query, "OnOfflineGarageDetailLoaded", "ii", playerid, garageid);
+    return 1;
+}
