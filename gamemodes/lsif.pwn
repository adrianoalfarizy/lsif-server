        return 0;
    }

    new gangIndex = GetPresetGangIndexByID(gangid);
    if (gangIndex == -1)
    {
        SendClientMessage(playerid, COLOR_RED, "Gang ID tidak valid.");
        return 0;
    }

    PlayerEditingGangPresetID[playerid] = gangid;

    new title[96];
