+stock SaveHouseStorageEditorCapacity(playerid, capacity)
+{
+    new houseIndex = PlayerHouseStorageEditHouseIndex[playerid];
+    if (!IsValidHouseIndex(houseIndex) || capacity < 1 || capacity > VehicleStorageMaxSlotsPerLocation) return 0;
+    new query[512];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE vehicle_storage_locations SET capacity=%d WHERE storage_type='house' AND reference_id=%d AND id NOT IN (SELECT storage_location_id FROM player_vehicle_storage GROUP BY storage_location_id HAVING COUNT(*)>%d) LIMIT 1",
