+}
+
+public OnGarageGeometryPreviewLoaded(playerid, geometryid, pointType)
+{
+    if (!IsPlayerConnected(playerid) || !IsAdminLevel(playerid, ADMIN_OWNER)) return 1;
+    if (cache_num_rows() <= 0) return QueryGarageGeometryDetail(playerid, geometryid);
+
+    new Float:x, Float:y, Float:z, Float:a = 0.0;
+    new name[40], geometryStatus[32], pointName[32];
+    cache_get_value_name(0, "garage_name", name, sizeof(name));
+    cache_get_value_name(0, "geometry_status", geometryStatus, sizeof(geometryStatus));
+
+    switch (pointType)
+    {
+        case 0:
+        {
+            cache_get_value_name_float(0, "interaction_x", x);
+            cache_get_value_name_float(0, "interaction_y", y);
+            cache_get_value_name_float(0, "interaction_z", z);
+            format(pointName, sizeof(pointName), "interaction");
+        }
+        case 1:
+        {
+            cache_get_value_name_float(0, "vehicle_entry_x", x);
+            cache_get_value_name_float(0, "vehicle_entry_y", y);
+            cache_get_value_name_float(0, "vehicle_entry_z", z);
+            cache_get_value_name_float(0, "vehicle_entry_a", a);
+            format(pointName, sizeof(pointName), "vehicle entry");
+        }
+        case 2:
+        {
+            cache_get_value_name_float(0, "vehicle_spawn_x", x);
+            cache_get_value_name_float(0, "vehicle_spawn_y", y);
+            cache_get_value_name_float(0, "vehicle_spawn_z", z);
+            cache_get_value_name_float(0, "vehicle_spawn_a", a);
+            format(pointName, sizeof(pointName), "vehicle spawn");
+        }
+        default: return QueryGarageGeometryDetail(playerid, geometryid);
+    }
+
+    if (floatabs(x) > 4000.0 || floatabs(y) > 4000.0 || z < -100.0 || z > 1500.0 || (floatabs(x) < 0.001 && floatabs(y) < 0.001 && floatabs(z) < 0.001))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Preview diblokir: geometry point unresolved/abnormal.");
+        return QueryGarageGeometryDetail(playerid, geometryid);
+    }
+
+    SaveOfflineInteriorPreviewReturn(playerid);
+    SetPlayerInterior(playerid, 0);
+    SetPlayerVirtualWorld(playerid, 0);
+    SetPlayerPos(playerid, x, y, z + 0.80);
+    SetPlayerFacingAngle(playerid, a);
+    SetCameraBehindPlayer(playerid);
+
+    new msg[260];
+    format(msg, sizeof(msg), "Preview %s geometry #%d %s [%s]. Tidak ada vehicle/checkpoint/object dibuat. /offlineintreturn untuk kembali.", pointName, geometryid, name, geometryStatus);
+    SendClientMessage(playerid, COLOR_GREEN, msg);
+    return 1;
+}
