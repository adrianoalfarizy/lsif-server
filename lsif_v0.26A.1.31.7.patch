+    new Float:halfWidth, Float:halfLength, Float:minZ;
+    GetDynamicParkingVehicleBounds(modelid, halfWidth, halfLength, minZ);
+    new dynamicStats[DYNAMIC_STAT_COUNT];
+    ResetDynamicParkingStats(dynamicStats);
