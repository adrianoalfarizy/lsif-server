    }

    if (!IsPlayerNearDealership(playerid))
    {
        SendClientMessage(playerid, COLOR_RED, "Kamu harus berada dekat dealership untuk repair kendaraan.");
        return 0;
    }

    new Float:health = OwnedVehicleHealth[playerid];
