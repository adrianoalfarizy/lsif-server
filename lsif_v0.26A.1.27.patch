+        catalogNondraft,
+        mappedPlanRows,
+        linkTotal,
+        linkEnabled,
+        orphanHouseLinks,
+        orphanGarageLinks,
+        zeroCenterRows,
+        spawnReadyRows,
+        spawnPendingRows,
+        policyEnabled,
