        if (!IsAdminLevel(playerid, ADMIN_HELPER))
        {
            SendClientMessage(playerid, COLOR_RED, "Kamu bukan admin.");
            return 1;
        }

        new name[MAX_PLAYER_NAME];
        new rankName[32];
