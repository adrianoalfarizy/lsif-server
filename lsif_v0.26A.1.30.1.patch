+}
+
+stock SetHouseStorageEditorEnabled(playerid, enabled)
+{
+    new houseIndex = PlayerHouseStorageEditHouseIndex[playerid];
+    if (!IsValidHouseIndex(houseIndex)) return 0;
+    new query[768];
+    if (enabled)
+    {
+        mysql_format(g_SQL, query, sizeof(query),
+            "UPDATE vehicle_storage_locations SET enabled=1,geometry_status='ready',apply_status='applied' WHERE storage_type='house' AND reference_id=%d AND interaction_x<>0 AND interaction_y<>0 AND interaction_z<>0 AND spawn_x<>0 AND spawn_y<>0 AND spawn_z<>0 LIMIT 1",
+            HouseCatalogID[houseIndex]);
+    }
+    else
+    {
+        mysql_format(g_SQL, query, sizeof(query),
+            "UPDATE vehicle_storage_locations SET enabled=0,apply_status='disabled' WHERE storage_type='house' AND reference_id=%d AND id NOT IN (SELECT storage_location_id FROM player_vehicle_storage) LIMIT 1",
+            HouseCatalogID[houseIndex]);
+    }
+    mysql_tquery(g_SQL, query, "OnHouseStorageEditorSaved", "ii", playerid, enabled ? 4 : 5);
+    return 1;
+}
+
+public OnHouseStorageEditorSaved(playerid, actionType)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Perubahan storage tidak diterapkan. Pastikan row sudah dibuat dan checkpoint/spawn valid.");
+        ShowHouseStorageAdminAction(playerid);
+        return 1;
+    }
+    LoadVehicleStorageLocations();
+    switch (actionType)
+    {
+        case 1: SendClientMessage(playerid, COLOR_GREEN, "Posisi checkpoint merah disimpan.");
+        case 2: SendClientMessage(playerid, COLOR_GREEN, "Posisi dan facing spawn kendaraan disimpan.");
+        case 3: SendClientMessage(playerid, COLOR_GREEN, "Kapasitas storage diperbarui.");
+        case 4: SendClientMessage(playerid, COLOR_GREEN, "House vehicle storage diaktifkan.");
+        case 5: SendClientMessage(playerid, COLOR_YELLOW, "House vehicle storage dinonaktifkan.");
+    }
+    ShowHouseStorageAdminAction(playerid);
+    return 1;
+}
