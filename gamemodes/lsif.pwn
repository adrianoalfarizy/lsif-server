                ShowPublicInteriorExteriorMenu(playerid, pubIntId);
            }
            case 5:
            {
                GotoPublicInteriorPoint(playerid, pubIntId, 5);
                ShowPublicInteriorExteriorMenu(playerid, pubIntId);
