+stock BuildHouseStorageTransactionToken(playerid, vehicleDbId, output[], size)
+{
+    format(output, size, "H%08x%08x%08x", PlayerDBID[playerid], vehicleDbId, GetTickCount() ^ random(1000000000));
+    return 1;
+}
