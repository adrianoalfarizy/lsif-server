+public OnVehicleStorageLocationsLoaded()
+{
+    new rows = cache_num_rows();
+    ResetVehicleStorageLocationArrays();
+    if (rows > MAX_VEHICLE_STORAGE_LOCATIONS) rows = MAX_VEHICLE_STORAGE_LOCATIONS;
+
+    for (new i = 0; i < rows; i++)
+    {
+        cache_get_value_name_int(i, "id", VehicleStorageLocationID[i]);
+        cache_get_value_name_int(i, "reference_id", VehicleStorageReferenceID[i]);
+        cache_get_value_name_int(i, "capacity", VehicleStorageCapacity[i]);
+        cache_get_value_name_int(i, "enabled", VehicleStorageEnabled[i]);
+        cache_get_value_name_int(i, "interior_id", VehicleStorageInterior[i]);
+        cache_get_value_name_int(i, "virtual_world", VehicleStorageVirtualWorld[i]);
+        cache_get_value_name(i, "location_name", VehicleStorageName[i], VEHICLE_STORAGE_NAME_SIZE);
+        cache_get_value_name(i, "storage_type", VehicleStorageType[i], VEHICLE_STORAGE_TYPE_SIZE);
+        cache_get_value_name_float(i, "interaction_x", VehicleStorageInteractionX[i]);
+        cache_get_value_name_float(i, "interaction_y", VehicleStorageInteractionY[i]);
+        cache_get_value_name_float(i, "interaction_z", VehicleStorageInteractionZ[i]);
+        cache_get_value_name_float(i, "interaction_radius", VehicleStorageInteractionRadius[i]);
+        cache_get_value_name_float(i, "spawn_x", VehicleStorageSpawnX[i]);
+        cache_get_value_name_float(i, "spawn_y", VehicleStorageSpawnY[i]);
+        cache_get_value_name_float(i, "spawn_z", VehicleStorageSpawnZ[i]);
+        cache_get_value_name_float(i, "spawn_a", VehicleStorageSpawnA[i]);
+    }
+
+    VehicleStorageLocationCount = rows;
+    VehicleStorageLocationsReady = true;
+
+    new logText[160];
+    format(logText, sizeof(logText), "[SAIF][VEHICLE-STORAGE] Loaded %d/%d enabled storage locations.", VehicleStorageLocationCount, MAX_VEHICLE_STORAGE_LOCATIONS);
+    print(logText);
+    return 1;
+}
