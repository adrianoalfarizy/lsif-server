+stock ResetVehicleStorageLocationArrays()
+{
+    VehicleStorageLocationsReady = false;
+    VehicleStorageLocationCount = 0;
+    for (new i = 0; i < MAX_VEHICLE_STORAGE_LOCATIONS; i++)
+    {
+        VehicleStorageLocationID[i] = 0;
+        VehicleStorageReferenceID[i] = 0;
+        VehicleStorageCapacity[i] = 0;
+        VehicleStorageEnabled[i] = 0;
+        VehicleStorageName[i][0] = EOS;
+        VehicleStorageType[i][0] = EOS;
+        VehicleStorageInteractionX[i] = 0.0;
+        VehicleStorageInteractionY[i] = 0.0;
+        VehicleStorageInteractionZ[i] = 0.0;
+        VehicleStorageInteractionRadius[i] = 2.5;
+        VehicleStorageSpawnX[i] = 0.0;
+        VehicleStorageSpawnY[i] = 0.0;
+        VehicleStorageSpawnZ[i] = 0.0;
+        VehicleStorageSpawnA[i] = 0.0;
+        VehicleStorageInterior[i] = 0;
+        VehicleStorageVirtualWorld[i] = 0;
+    }
+    return 1;
+}
