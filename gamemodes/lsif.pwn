            case 3: ShowPlayerDialog(playerid, DIALOG_PUBINT_EXT_PICKUP_MODEL_INPUT, DIALOG_STYLE_INPUT, "Pickup Panah Exterior Model", "Masukkan model pickup panah exterior.\nDefault rekomendasi: 1318", "Save", "Back");
            case 4:
            {
