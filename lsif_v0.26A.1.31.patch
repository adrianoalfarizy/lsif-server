+stock FindNearestOwnedVehicleSpawn(playerid, &Float:x, &Float:y, &Float:z, &Float:a)
+{
+    if (!OwnedVehicleSpawnPointsReady || OwnedVehicleSpawnPointCount <= 0) return 0;
+    new best = -1;
+    new Float:bestDistance = OWNED_VEHICLE_SPAWN_SEARCH_LIMIT + 1.0;
+    new interior = GetPlayerInterior(playerid);
+    new vw = GetPlayerVirtualWorld(playerid);
+    for (new i = 0; i < OwnedVehicleSpawnPointCount; i++)
+    {
+        if (OwnedVehicleSpawnPointInterior[i] != interior || OwnedVehicleSpawnPointVW[i] != vw) continue;
+        new Float:distance = GetPlayerDistanceFromPoint(playerid, OwnedVehicleSpawnPointX[i], OwnedVehicleSpawnPointY[i], OwnedVehicleSpawnPointZ[i]);
+        if (distance >= bestDistance || distance > OWNED_VEHICLE_SPAWN_SEARCH_LIMIT) continue;
+        if (IsAnyVehicleNearOwnedSpawn(OwnedVehicleSpawnPointX[i], OwnedVehicleSpawnPointY[i], OwnedVehicleSpawnPointZ[i], OWNED_VEHICLE_SPAWN_CLEAR_RADIUS)) continue;
+        best = i;
+        bestDistance = distance;
+    }
+    if (best == -1) return 0;
+    x = OwnedVehicleSpawnPointX[best];
+    y = OwnedVehicleSpawnPointY[best];
+    z = OwnedVehicleSpawnPointZ[best];
+    a = OwnedVehicleSpawnPointA[best];
+    return 1;
+}
