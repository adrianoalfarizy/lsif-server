+            }
+            if (IsValidGarageSlot(OwnedVehicleSlot[playerid]))
+            {
+                PlayerGarageX[playerid][OwnedVehicleSlot[playerid]]=homeX;
+                PlayerGarageY[playerid][OwnedVehicleSlot[playerid]]=homeY;
+                PlayerGarageZ[playerid][OwnedVehicleSlot[playerid]]=homeZ;
