        if (strlen(message) < 5)
        {
            SendClientMessage(playerid, COLOR_YELLOW, "Gunakan: /bugreport [jelaskan bug minimal 5 karakter]");
            return 1;
        }

        CreateFeedbackReport(playerid, "bug", message);
        return 1;
