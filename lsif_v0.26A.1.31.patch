+stock ProcessOwnedVehicleColorModification(playerid, color1, color2)
+{
+    if (!VehicleStorageColorModificationEnabled)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Modifikasi warna sedang dinonaktifkan oleh policy.");
+        return 0;
+    }
+    if (!IsPlayerDrivingActiveOwnedVehicle(playerid))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kamu harus mengemudikan owned vehicle aktif.");
+        return 0;
+    }
+    if (color1 < 0 || color1 > 255 || color2 < 0 || color2 > 255)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Color ID harus 0 sampai 255.");
+        return 0;
+    }
+    OwnedVehiclePendingColor1[playerid] = color1;
+    OwnedVehiclePendingColor2[playerid] = color2;
+    OwnedVehicleModificationDirty[playerid] = 1;
+    ChangeVehicleColor(OwnedVehicleID[playerid], color1, color2);
+    new msg[192];
+    format(msg, sizeof(msg), "Preview warna diterapkan: %d / %d. Simpan kendaraan di garage agar permanen.", color1, color2);
+    SendClientMessage(playerid, COLOR_GREEN, msg);
+    return 1;
+}
