+stock IsAnyVehicleNearOwnedSpawn(Float:x, Float:y, Float:z, Float:radius)
+{
+    for (new vehicleid = 1; vehicleid < MAX_VEHICLES; vehicleid++)
+    {
+        if (!IsValidVehicle(vehicleid)) continue;
+        new Float:vx, Float:vy, Float:vz;
+        GetVehiclePos(vehicleid, vx, vy, vz);
+        if (floatsqroot(floatpower(vx-x,2.0)+floatpower(vy-y,2.0)+floatpower(vz-z,2.0)) <= radius) return 1;
+    }
+    return 0;
+}
