+        "Kendaraan: %s\nGarage slot: %d\nLokasi: %s\nKapasitas: %d/%d\n\nKendaraan akan disimpan dan hilang dari dunia. Ambil kembali melalui checkpoint merah rumah ini.",
+        PlayerGarageName[playerid][slotIndex], slotIndex + 1, VehicleStorageName[locationIndex],
+        GetStoredVehicleCountAtLocation(playerid, VehicleStorageLocationID[locationIndex]), VehicleStorageCapacity[locationIndex]);
+    ShowPlayerDialog(playerid, DIALOG_HOUSE_STORAGE_STORE_CONFIRM, DIALOG_STYLE_MSGBOX,
+        "Simpan Kendaraan di Rumah", body, "Simpan", "Batal");
+    return 1;
+}
+
+stock ShowHouseVehicleRetrieveList(playerid, locationIndex)
+{
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount) return 0;
+    new body[768];
+    new row[160];
+    body[0] = EOS;
+    PlayerHouseStorageRetrieveCount[playerid] = 0;
+    for (new i = 0; i < MAX_GARAGE_SLOTS; i++) PlayerHouseStorageRetrieveSlotMap[playerid][i] = -1;
+
+    for (new slotIndex = 0; slotIndex < MAX_GARAGE_SLOTS; slotIndex++)
+    {
+        if (!PlayerGarageStored[playerid][slotIndex]) continue;
+        if (PlayerGarageStorageLocationID[playerid][slotIndex] != VehicleStorageLocationID[locationIndex]) continue;
+        new rowIndex = PlayerHouseStorageRetrieveCount[playerid];
+        if (rowIndex >= MAX_GARAGE_SLOTS) break;
+        PlayerHouseStorageRetrieveSlotMap[playerid][rowIndex] = slotIndex;
+        format(row, sizeof(row), "Slot %d: %s | Model %d | Fuel %d | HP %.0f\n",
+            slotIndex + 1, PlayerGarageName[playerid][slotIndex], PlayerGarageModel[playerid][slotIndex],
+            PlayerGarageFuel[playerid][slotIndex], PlayerGarageHealth[playerid][slotIndex]);
+        strcat(body, row, sizeof(body));
+        PlayerHouseStorageRetrieveCount[playerid]++;
+    }
+
+    if (PlayerHouseStorageRetrieveCount[playerid] <= 0)
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Tidak ada kendaraan yang tersimpan di rumah ini.");
+        return 1;
+    }
+
+    PlayerDialogHouseStorageLocationIndex[playerid] = locationIndex;
+    ShowPlayerDialog(playerid, DIALOG_HOUSE_STORAGE_RETRIEVE_LIST, DIALOG_STYLE_LIST,
+        "Ambil Kendaraan dari Rumah", body, "Ambil", "Tutup");
+    return 1;
+}
+
+stock TryHandleHouseVehicleStorageAlt(playerid)
+{
+    if (PlayerHouseStorageOperationPending[playerid])
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Proses penyimpanan kendaraan sebelumnya masih berjalan.");
+        return 1;
+    }
+    if (!VehicleStoragePolicyReady || !VehicleStorageLocationsReady) return 0;
+    if (!VehicleStoragePolicyEnabled || !VehicleStorageHouseEnabled) return 0;
+    if (PlayerHouseDBID[playerid] <= 0 || PlayerHouseCatalogID[playerid] <= 0) return 0;
+
+    new locationIndex = GetHouseVehicleStorageLocationIndex(PlayerHouseCatalogID[playerid]);
+    if (locationIndex == -1 || !IsPlayerNearVehicleStorageLocation(playerid, locationIndex)) return 0;
+
+    if (IsPlayerInAnyVehicle(playerid))
+    {
+        if (!VehicleStorageStoreEnabled)
+        {
+            SendClientMessage(playerid, COLOR_RED, "Penyimpanan kendaraan rumah sedang dinonaktifkan oleh policy.");
+            return 1;
+        }
+        if (VehicleStorageDriverRequired && GetPlayerState(playerid) != PLAYER_STATE_DRIVER)
+        {
+            SendClientMessage(playerid, COLOR_RED, "Kamu harus menjadi pengemudi kendaraan.");
+            return 1;
+        }
+        if (VehicleStorageOwnerRequired && !IsPlayerDrivingActiveOwnedVehicle(playerid))
+        {
+            SendClientMessage(playerid, COLOR_RED, "Hanya kendaraan pribadi aktif milikmu yang bisa disimpan.");
+            return 1;
+        }
+        if (HasOtherPlayerInVehicle(playerid, GetPlayerVehicleID(playerid)))
+        {
+            SendClientMessage(playerid, COLOR_RED, "Turunkan semua penumpang sebelum menyimpan kendaraan.");
+            return 1;
+        }
+        new slotIndex = OwnedVehicleSlot[playerid];
+        if (!IsValidGarageSlot(slotIndex) || PlayerGarageStored[playerid][slotIndex])
+        {
+            SendClientMessage(playerid, COLOR_RED, "Status penyimpanan kendaraan tidak valid.");
+            return 1;
+        }
+        new Float:health;
+        GetVehicleHealth(OwnedVehicleID[playerid], health);
+        if (health < VEHICLE_STORAGE_MIN_HEALTH)
+        {
+            SendClientMessage(playerid, COLOR_RED, "Kendaraan terlalu rusak untuk disimpan. Repair terlebih dahulu.");
+            return 1;
+        }
+        if (GetFreeStoredVehicleSlotAtLocation(playerid, locationIndex) == -1)
+        {
+            SendClientMessage(playerid, COLOR_RED, "Kapasitas penyimpanan rumah ini sudah penuh.");
+            return 1;
+        }
+        return ShowHouseVehicleStoreConfirm(playerid, locationIndex);
+    }
+
+    if (!VehicleStorageRetrieveEnabled)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Pengambilan kendaraan rumah sedang dinonaktifkan oleh policy.");
+        return 1;
+    }
+    if (OwnedVehicleID[playerid] != INVALID_VEHICLE_ID)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Masih ada kendaraan pribadi aktif di dunia. Simpan/parkir kendaraan itu terlebih dahulu.");
+        return 1;
+    }
+    return ShowHouseVehicleRetrieveList(playerid, locationIndex);
+}
+
+stock ProcessHouseVehicleStore(playerid, locationIndex)
+{
+    if (PlayerHouseStorageOperationPending[playerid])
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Proses penyimpanan kendaraan sebelumnya masih berjalan.");
+        return 0;
+    }
+    if (!IsPlayerDrivingActiveOwnedVehicle(playerid))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kamu tidak lagi mengemudikan kendaraan pribadi aktif.");
+        return 0;
+    }
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount || !IsPlayerNearVehicleStorageLocation(playerid, locationIndex))
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kendaraan harus tetap berada di checkpoint merah rumah.");
+        return 0;
+    }
+
+    new slotIndex = OwnedVehicleSlot[playerid];
+    new storageSlot = GetFreeStoredVehicleSlotAtLocation(playerid, locationIndex);
+    if (storageSlot == -1)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Kapasitas penyimpanan rumah sudah penuh.");
+        return 0;
+    }
+
+    GetVehicleHealth(OwnedVehicleID[playerid], PlayerPendingHouseStorageHealth[playerid]);
+    PlayerPendingHouseStorageFuel[playerid] = OwnedVehicleFuel[playerid];
+    PlayerPendingHouseStorageLocked[playerid] = OwnedVehicleLocked[playerid];
+    PlayerPendingHouseStorageLocationIndex[playerid] = locationIndex;
+    PlayerPendingHouseStorageVehicleSlot[playerid] = slotIndex;
+    PlayerPendingHouseStorageDBSlot[playerid] = storageSlot;
+    PlayerPendingHouseStorageVehicleID[playerid] = OwnedVehicleID[playerid];
+    PlayerHouseStorageOperationPending[playerid] = 1;
+    BuildHouseStorageTransactionToken(playerid, OwnedVehicleDBID[playerid], PlayerPendingHouseStorageToken[playerid], 40);
+
+    new query[1024];
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO player_vehicle_storage (player_vehicle_id,owner_player_id,storage_location_id,storage_slot,storage_status,stored_health,stored_fuel,stored_locked,transaction_token,source_tag) VALUES (%d,%d,%d,%d,'stored',%f,%d,%d,'%e','saif_house_storage_runtime_v0.26A.1.30.1')",
+        OwnedVehicleDBID[playerid], PlayerDBID[playerid], VehicleStorageLocationID[locationIndex], storageSlot,
+        PlayerPendingHouseStorageHealth[playerid], PlayerPendingHouseStorageFuel[playerid],
+        PlayerPendingHouseStorageLocked[playerid], PlayerPendingHouseStorageToken[playerid]);
+    mysql_tquery(g_SQL, query, "OnHouseVehicleStored", "iii", playerid, slotIndex, locationIndex);
+    SendClientMessage(playerid, COLOR_YELLOW, "Menyimpan kendaraan ke database...");
+    return 1;
+}
+
+public OnHouseVehicleStored(playerid, slotIndex, locationIndex)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        PlayerPendingHouseStorageVehicleID[playerid] = INVALID_VEHICLE_ID;
+        SendClientMessage(playerid, COLOR_RED, "Gagal menyimpan kendaraan. Kendaraan mungkin sudah tersimpan atau slot penuh.");
+        return 1;
+    }
+    if (!IsValidGarageSlot(slotIndex) || locationIndex < 0 || locationIndex >= VehicleStorageLocationCount)
+    {
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        PlayerPendingHouseStorageVehicleID[playerid] = INVALID_VEHICLE_ID;
+        return 1;
+    }
+
+    new storageSlot = PlayerPendingHouseStorageDBSlot[playerid];
+    if (storageSlot < 1) storageSlot = 1;
+    new query[1024];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE player_vehicles SET pos_x=%f,pos_y=%f,pos_z=%f,pos_a=%f,health=%f,fuel=%d,locked=%d WHERE id=%d AND owner_id=%d LIMIT 1",
+        VehicleStorageSpawnX[locationIndex], VehicleStorageSpawnY[locationIndex], VehicleStorageSpawnZ[locationIndex], VehicleStorageSpawnA[locationIndex],
+        PlayerPendingHouseStorageHealth[playerid], PlayerPendingHouseStorageFuel[playerid], PlayerPendingHouseStorageLocked[playerid],
+        PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid]);
+    mysql_tquery(g_SQL, query);
+
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO vehicle_storage_transactions (transaction_token,action_type,status,player_vehicle_id,owner_player_id,to_storage_location_id,storage_slot,vehicle_health,vehicle_fuel,vehicle_locked,source_tag,completed_at) SELECT '%e','store','complete',player_vehicle_id,owner_player_id,storage_location_id,storage_slot,stored_health,stored_fuel,stored_locked,'saif_house_storage_runtime_v0.26A.1.30.1',NOW() FROM player_vehicle_storage WHERE player_vehicle_id=%d LIMIT 1",
+        PlayerPendingHouseStorageToken[playerid], PlayerGarageDBID[playerid][slotIndex]);
+    mysql_tquery(g_SQL, query);
+
+    PlayerGarageStored[playerid][slotIndex] = 1;
+    PlayerGarageStorageLocationID[playerid][slotIndex] = VehicleStorageLocationID[locationIndex];
+    PlayerGarageStorageSlot[playerid][slotIndex] = storageSlot;
+    PlayerGarageX[playerid][slotIndex] = VehicleStorageSpawnX[locationIndex];
+    PlayerGarageY[playerid][slotIndex] = VehicleStorageSpawnY[locationIndex];
+    PlayerGarageZ[playerid][slotIndex] = VehicleStorageSpawnZ[locationIndex];
+    PlayerGarageA[playerid][slotIndex] = VehicleStorageSpawnA[locationIndex];
+    PlayerGarageHealth[playerid][slotIndex] = PlayerPendingHouseStorageHealth[playerid];
+    PlayerGarageFuel[playerid][slotIndex] = PlayerPendingHouseStorageFuel[playerid];
+    PlayerGarageLocked[playerid][slotIndex] = PlayerPendingHouseStorageLocked[playerid];
+
+    new pendingVehicleId = PlayerPendingHouseStorageVehicleID[playerid];
+    if (pendingVehicleId != INVALID_VEHICLE_ID)
+    {
+        if (GetPlayerVehicleID(playerid) == pendingVehicleId) RemovePlayerFromVehicle(playerid);
+        if (OwnedVehicleID[playerid] == pendingVehicleId)
+        {
+            DestroyOwnedVehicleLabel(playerid);
+            DestroyVehicle(pendingVehicleId);
+            OwnedVehicleID[playerid] = INVALID_VEHICLE_ID;
+        }
+        else
+        {
+            DestroyVehicle(pendingVehicleId);
+        }
+    }
+    PlayerHouseStorageOperationPending[playerid] = 0;
+    PlayerPendingHouseStorageVehicleID[playerid] = INVALID_VEHICLE_ID;
+
+    new msg[192];
+    format(msg, sizeof(msg), "Kendaraan %s berhasil disimpan di %s.", PlayerGarageName[playerid][slotIndex], VehicleStorageName[locationIndex]);
+    SendClientMessage(playerid, COLOR_GREEN, msg);
+    SendClientMessage(playerid, COLOR_WHITE, "Datang ke checkpoint merah rumah ini dalam keadaan berjalan kaki lalu tekan ALT untuk mengambil kendaraan.");
+    return 1;
+}
+
+stock ProcessHouseVehicleRetrieve(playerid, slotIndex, locationIndex)
+{
+    if (PlayerHouseStorageOperationPending[playerid])
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Proses penyimpanan kendaraan sebelumnya masih berjalan.");
+        return 0;
+    }
+    if (!IsValidGarageSlot(slotIndex) || !PlayerGarageStored[playerid][slotIndex]) return 0;
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount || !IsPlayerNearVehicleStorageLocation(playerid, locationIndex)) return 0;
+    if (OwnedVehicleID[playerid] != INVALID_VEHICLE_ID)
+    {
+        SendClientMessage(playerid, COLOR_RED, "Masih ada kendaraan pribadi aktif di dunia.");
+        return 0;
+    }
+
+    PlayerPendingHouseStorageLocationIndex[playerid] = locationIndex;
+    PlayerPendingHouseStorageVehicleSlot[playerid] = slotIndex;
+    PlayerPendingHouseStorageDBSlot[playerid] = PlayerGarageStorageSlot[playerid][slotIndex];
+    PlayerHouseStorageOperationPending[playerid] = 2;
+    BuildHouseStorageTransactionToken(playerid, PlayerGarageDBID[playerid][slotIndex], PlayerPendingHouseStorageToken[playerid], 40);
+
+    new query[512];
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE player_vehicle_storage SET storage_status='releasing',transaction_token='%e' WHERE player_vehicle_id=%d AND owner_player_id=%d AND storage_location_id=%d AND storage_status IN ('stored','releasing') LIMIT 1",
+        PlayerPendingHouseStorageToken[playerid], PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid], VehicleStorageLocationID[locationIndex]);
+    mysql_tquery(g_SQL, query, "OnHouseVehicleRetrieved", "iii", playerid, slotIndex, locationIndex);
+    SendClientMessage(playerid, COLOR_YELLOW, "Mengambil kendaraan dari penyimpanan...");
+    return 1;
+}
+
+public OnHouseVehicleRetrieved(playerid, slotIndex, locationIndex)
+{
+    if (!IsPlayerConnected(playerid)) return 1;
+    if (cache_affected_rows() <= 0)
+    {
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        SendClientMessage(playerid, COLOR_RED, "Gagal mengambil kendaraan. Status penyimpanan tidak ditemukan.");
+        LoadPlayerGarage(playerid);
+        return 1;
+    }
+    if (!IsValidGarageSlot(slotIndex) || locationIndex < 0 || locationIndex >= VehicleStorageLocationCount)
+    {
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        return 1;
+    }
+
+    new oldLocationId = VehicleStorageLocationID[locationIndex];
+    new query[1024];
+
+    if (OwnedVehicleID[playerid] != INVALID_VEHICLE_ID)
+    {
+        mysql_format(g_SQL, query, sizeof(query),
+            "UPDATE player_vehicle_storage SET storage_status='stored' WHERE player_vehicle_id=%d AND owner_player_id=%d AND storage_location_id=%d AND storage_status='releasing' LIMIT 1",
+            PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid], oldLocationId);
+        mysql_tquery(g_SQL, query);
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        SendClientMessage(playerid, COLOR_RED, "Pengambilan dibatalkan karena ada kendaraan pribadi lain yang sudah aktif.");
+        return 1;
+    }
+
+    PlayerGarageX[playerid][slotIndex] = VehicleStorageSpawnX[locationIndex];
+    PlayerGarageY[playerid][slotIndex] = VehicleStorageSpawnY[locationIndex];
+    PlayerGarageZ[playerid][slotIndex] = VehicleStorageSpawnZ[locationIndex];
+    PlayerGarageA[playerid][slotIndex] = VehicleStorageSpawnA[locationIndex];
+
+    SetActiveVehicleFromGarage(playerid, slotIndex);
+    if (!SpawnOwnedVehicle(playerid))
+    {
+        mysql_format(g_SQL, query, sizeof(query),
+            "UPDATE player_vehicle_storage SET storage_status='stored' WHERE player_vehicle_id=%d AND owner_player_id=%d AND storage_location_id=%d AND storage_status='releasing' LIMIT 1",
+            PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid], oldLocationId);
+        mysql_tquery(g_SQL, query);
+        PlayerHouseStorageOperationPending[playerid] = 0;
+        SendClientMessage(playerid, COLOR_RED, "Spawn kendaraan gagal; status penyimpanan dikembalikan.");
+        return 1;
+    }
+
+    mysql_format(g_SQL, query, sizeof(query),
+        "DELETE FROM player_vehicle_storage WHERE player_vehicle_id=%d AND owner_player_id=%d AND storage_location_id=%d AND storage_status='releasing' LIMIT 1",
+        PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid], oldLocationId);
+    mysql_tquery(g_SQL, query);
+
+    PlayerGarageStored[playerid][slotIndex] = 0;
+    PlayerGarageStorageLocationID[playerid][slotIndex] = 0;
+    PlayerGarageStorageSlot[playerid][slotIndex] = 0;
+    mysql_format(g_SQL, query, sizeof(query),
+        "UPDATE player_vehicles SET pos_x=%f,pos_y=%f,pos_z=%f,pos_a=%f WHERE id=%d AND owner_id=%d LIMIT 1",
+        VehicleStorageSpawnX[locationIndex], VehicleStorageSpawnY[locationIndex], VehicleStorageSpawnZ[locationIndex], VehicleStorageSpawnA[locationIndex],
+        PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid]);
+    mysql_tquery(g_SQL, query);
+
+    mysql_format(g_SQL, query, sizeof(query),
+        "INSERT INTO vehicle_storage_transactions (transaction_token,action_type,status,player_vehicle_id,owner_player_id,from_storage_location_id,storage_slot,vehicle_health,vehicle_fuel,vehicle_locked,source_tag,completed_at) VALUES ('%e','retrieve','complete',%d,%d,%d,%d,%f,%d,%d,'saif_house_storage_runtime_v0.26A.1.30.1',NOW())",
+        PlayerPendingHouseStorageToken[playerid], PlayerGarageDBID[playerid][slotIndex], PlayerDBID[playerid], oldLocationId, PlayerPendingHouseStorageDBSlot[playerid],
+        PlayerGarageHealth[playerid][slotIndex], PlayerGarageFuel[playerid][slotIndex], PlayerGarageLocked[playerid][slotIndex]);
+    mysql_tquery(g_SQL, query);
+    PlayerHouseStorageOperationPending[playerid] = 0;
+
+    new msg[192];
+    format(msg, sizeof(msg), "Kendaraan %s berhasil dikeluarkan dari %s.", PlayerGarageName[playerid][slotIndex], VehicleStorageName[locationIndex]);
+    SendClientMessage(playerid, COLOR_GREEN, msg);
+    return 1;
+}
