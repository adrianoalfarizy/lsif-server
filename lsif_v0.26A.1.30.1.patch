+stock LoadVehicleStorageLocations()
+{
+    ResetVehicleStorageLocationArrays();
+    if (!g_DatabaseReady || g_SQL == MYSQL_INVALID_HANDLE) return 0;
+
+    new query[1024];
+    format(query, sizeof(query),
+        "SELECT id,storage_type,COALESCE(reference_id,0) reference_id,location_name,capacity,");
+    strcat(query,
+        "interaction_x,interaction_y,interaction_z,interaction_radius,spawn_x,spawn_y,spawn_z,spawn_a,",
+        sizeof(query));
+    strcat(query,
+        "interior_id,virtual_world,enabled FROM vehicle_storage_locations WHERE enabled=1 AND geometry_status='ready' ORDER BY id ASC LIMIT 64",
+        sizeof(query));
+    mysql_tquery(g_SQL, query, "OnVehicleStorageLocationsLoaded");
+    return 1;
+}
