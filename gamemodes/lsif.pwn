        case 22..24: return 35;
        case 25..27: return 20;
        case 28..32: return 80;
        case 33..34: return 20;
        case 35..38: return 5;
        case 39: return 3;
        case 40: return 1;
        case 41..43: return 100;
        case 44..46: return 1;
