        dialogText,
        sizeof(dialogText),
        "Vehicle: %s\nModel ID: %d\nPrice: $%d\n\nKendaraan akan masuk ke slot garage kosong pertama.\nLanjutkan pembelian?",
        ShopVehicleName[shopIndex],
        ShopVehicleModel[shopIndex],
        ShopVehiclePrice[shopIndex]
    );

