+stock QueryOfflineGarageList(playerid, page = 0)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+    if (page < 0) page = 0;
+
+    PlayerOfflineGaragePage[playerid] = page;
+    PlayerOfflineGarageListCount[playerid] = 0;
+
+    new query[1300];
+    mysql_format(g_SQL, query, sizeof(query),
+        "SELECT id,garage_name,runtime_class,safety_class,link_status,city_region,area_code,linked_house_count,baseline_house_count,story_house_count,garage_type,garage_door_type FROM offline_garage_canonical_plan WHERE BINARY resolver_version=BINARY '%e' ORDER BY FIELD(safety_class,'baseline_savehouse_candidate','story_asset_deferred','service_reference','world_reference'),city_region,garage_name,id LIMIT %d,%d",
+        "saif-garage-canonical-resolver-v0.26A.1.26", page * OFFLINE_GARAGE_PAGE_SIZE, OFFLINE_GARAGE_PAGE_SIZE + 1);
+    mysql_tquery(g_SQL, query, "OnOfflineGarageListLoaded", "ii", playerid, page);
+    return 1;
+}
+
+public OnOfflineGarageListLoaded(playerid, page)
+{
+    if (!IsPlayerConnected(playerid) || !IsAdminLevel(playerid, ADMIN_OWNER)) return 1;
+
+    new rows;
+    cache_get_row_count(rows);
+    PlayerOfflineGaragePage[playerid] = page;
+    PlayerOfflineGarageListCount[playerid] = 0;
+
+    new body[5400];
+    body[0] = EOS;
+    strcat(body, "Garage\tClass / Link\tArea / Type\n", sizeof(body));
+
+    if (page > 0)
+    {
+        PlayerOfflineGarageListDBID[playerid][PlayerOfflineGarageListCount[playerid]++] = -1;
+        strcat(body, "<< Previous Page\t\tNavigation\n", sizeof(body));
+    }
+
+    new dataRows = rows;
+    if (dataRows > OFFLINE_GARAGE_PAGE_SIZE) dataRows = OFFLINE_GARAGE_PAGE_SIZE;
+    for (new i = 0; i < dataRows; i++)
+    {
+        new id, linkedCount, baselineCount, storyCount, garageType, doorType;
+        new name[32], runtimeClass[40], safetyClass[48], linkStatus[32], region[32], area[32], line[300], linkText[96];
+        cache_get_value_name_int(i, "id", id);
+        cache_get_value_name_int(i, "linked_house_count", linkedCount);
+        cache_get_value_name_int(i, "baseline_house_count", baselineCount);
+        cache_get_value_name_int(i, "story_house_count", storyCount);
+        cache_get_value_name_int(i, "garage_type", garageType);
+        cache_get_value_name_int(i, "garage_door_type", doorType);
+        cache_get_value_name(i, "garage_name", name, sizeof(name));
+        cache_get_value_name(i, "runtime_class", runtimeClass, sizeof(runtimeClass));
+        cache_get_value_name(i, "safety_class", safetyClass, sizeof(safetyClass));
+        cache_get_value_name(i, "link_status", linkStatus, sizeof(linkStatus));
+        cache_get_value_name(i, "city_region", region, sizeof(region));
+        cache_get_value_name(i, "area_code", area, sizeof(area));
+
+        if (linkedCount > 0) format(linkText, sizeof(linkText), "%s / H%d B%d S%d", linkStatus, linkedCount, baselineCount, storyCount);
+        else format(linkText, sizeof(linkText), "%s", linkStatus);
+
+        PlayerOfflineGarageListDBID[playerid][PlayerOfflineGarageListCount[playerid]++] = id;
+        format(line, sizeof(line), "#%d %s\t%s / %s\t%s-%s / T%d D%d\n", id, name, runtimeClass, linkText, region, area, garageType, doorType);
+        strcat(body, line, sizeof(body));
+    }
+
+    if (rows > OFFLINE_GARAGE_PAGE_SIZE && PlayerOfflineGarageListCount[playerid] < MAX_OFFLINE_GARAGE_DIALOG_ROWS)
+    {
+        PlayerOfflineGarageListDBID[playerid][PlayerOfflineGarageListCount[playerid]++] = -2;
+        strcat(body, ">> Next Page\t\tNavigation\n", sizeof(body));
+    }
+
+    if (dataRows == 0 && page == 0) strcat(body, "No rows\tRun SQL v0.26A.1.26\tRead-only\n", sizeof(body));
+    ShowPlayerDialog(playerid, DIALOG_OFFLINE_GARAGE_LIST, DIALOG_STYLE_TABLIST_HEADERS,
+                     "GTA SA Garage Canonical Definitions", body, "Detail", "Back");
+    return 1;
+}
