+stock QueryGarageGeometrySummary(playerid)
+{
+    if (!CanUseOfflineImportAudit(playerid)) return 0;
+
+    new query[1900];
+    query[0] = EOS;
+    strcat(query, "SELECT s.id,s.status,s.total_rows,s.baseline_rows,s.baseline_ready_rows,s.story_rows,s.service_rows,s.world_reference_rows,", sizeof(query));
+    strcat(query, "s.invalid_bounds,s.invalid_dimensions,s.invalid_spawn,", sizeof(query));
+    strcat(query, "(SELECT COUNT(*) FROM offline_garage_geometry_plan p WHERE p.geometry_session_id=s.id AND p.enabled<>0) enabled_rows,", sizeof(query));
+    strcat(query, "(SELECT COUNT(*) FROM offline_garage_geometry_plan p WHERE p.geometry_session_id=s.id AND p.apply_status<>'draft') nondraft_rows ", sizeof(query));
+    strcat(query, "FROM offline_garage_geometry_sessions s WHERE BINARY s.planner_version=BINARY 'saif-garage-geometry-planner-v0.26A.1.28' ORDER BY s.id DESC LIMIT 1", sizeof(query));
+    mysql_tquery(g_SQL, query, "OnGarageGeometrySummaryLoaded", "i", playerid);
+    return 1;
+}
+
+public OnGarageGeometrySummaryLoaded(playerid)
+{
+    if (!IsPlayerConnected(playerid) || !IsAdminLevel(playerid, ADMIN_OWNER)) return 1;
+    if (cache_num_rows() <= 0)
+    {
+        SendClientMessage(playerid, COLOR_YELLOW, "Garage geometry planner belum tersedia. Jalankan migration + planner v0.26A.1.28.");
+        return ShowOfflineImportAuditMenu(playerid);
+    }
+
+    new sessionid, total, baseline, baselineReady, story, services, worldRefs, invalidBounds, invalidDimensions, invalidSpawn, enabledRows, nondraftRows;
+    new status[24];
+    cache_get_value_name_int(0, "id", sessionid);
+    cache_get_value_name_int(0, "total_rows", total);
+    cache_get_value_name_int(0, "baseline_rows", baseline);
+    cache_get_value_name_int(0, "baseline_ready_rows", baselineReady);
+    cache_get_value_name_int(0, "story_rows", story);
+    cache_get_value_name_int(0, "service_rows", services);
+    cache_get_value_name_int(0, "world_reference_rows", worldRefs);
+    cache_get_value_name_int(0, "invalid_bounds", invalidBounds);
+    cache_get_value_name_int(0, "invalid_dimensions", invalidDimensions);
+    cache_get_value_name_int(0, "invalid_spawn", invalidSpawn);
+    cache_get_value_name_int(0, "enabled_rows", enabledRows);
+    cache_get_value_name_int(0, "nondraft_rows", nondraftRows);
+    cache_get_value_name(0, "status", status, sizeof(status));
+
+    new body[2600];
+    format(body, sizeof(body),
+        "Garage Vehicle Spawn & Interaction Geometry Planner v0.26A.1.28\n\nSession: %d\nStatus: %s\nGeometry rows: %d / 52\n\nBaseline savehouse\nCandidates: %d / 12\nGeometry ready: %d / 12\n\nDeferred/reference\nStory rows: %d\nService rows: %d\nWorld reference rows: %d\n\nGeometry gates\nInvalid bounds: %d\nInvalid dimensions: %d\nInvalid spawn: %d\n\nSafety\nEnabled rows: %d (must be 0)\nNon-draft rows: %d (must be 0)\nRuntime garage/vehicle/door/checkpoint mutation: none\n\nBrowse untuk melihat front edge, interaction point, entry transform, vehicle spawn transform, heading, dan dimensi exact GRGE.",
+        sessionid, status, total, baseline, baselineReady, story, services, worldRefs,
+        invalidBounds, invalidDimensions, invalidSpawn, enabledRows, nondraftRows);
+    ShowPlayerDialog(playerid, DIALOG_GARAGE_GEOMETRY_SUMMARY, DIALOG_STYLE_MSGBOX,
+                     "Garage Geometry Planner", body, "Browse", "Back");
+    return 1;
+}
