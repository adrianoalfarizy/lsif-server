stock CreateDynamicLocationAtPlayer(playerid, const locType[], const locName[])
{
    new Float:x, Float:y, Float:z, Float:a;
    new query[1200];
    new labelText[LOC_LABEL_SIZE];
    new defaultIcon = GetDefaultDynamicLocationIcon(locType);
    new defaultPickup = WORLD_MARKER_PICKUP_MODEL;

    // v0.21A.2: lokasi dynamic default-nya adalah marker/pickup non-solid.
    // Object visual permanen dipisah lewat /locobject agar tidak mengganggu movement/player collision.

    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    format(labelText, sizeof(labelText), "[ALT] %s\n%s", locType, locName);

    mysql_format(
        g_SQL,
        query,
        sizeof(query),
        "INSERT INTO world_locations (location_key, location_type, display_name, pos_x, pos_y, pos_z, pos_a, interior, virtual_world, map_icon, pickup_model, object_model, label_text, interaction_radius, enabled, source_tag) VALUES ('%e', '%e', '%e', %f, %f, %f, %f, %d, %d, %d, %d, 0, '%e', 3.0, 1, 'manual')",
        locName,
        locType,
        locName,
        x,
        y,
        z,
        a,
        GetPlayerInterior(playerid),
        GetPlayerVirtualWorld(playerid),
        defaultIcon,
        defaultPickup,
        labelText
    );

    mysql_tquery(g_SQL, query, "OnDynamicLocationCreated", "i", playerid);
    return 1;
}

stock ShowDynamicLocationListDialog(playerid)
{
    new body[4096];
    new line[192];

    if (DynamicLocationCount == 0)
    {
        ShowPlayerDialog(playerid, DIALOG_DYNAMIC_LOCATION_INFO, DIALOG_STYLE_MSGBOX, "Dynamic Locations", "Belum ada dynamic location aktif.", "Back", "Close");
        return 1;
    }

    format(body, sizeof(body), "ID\tType\tIcon\tRadius\tName\n");

    for (new i = 0; i < DynamicLocationCount; i++)
    {
        format(line, sizeof(line), "%d\t%s\t%d\t%.1f\t%s\n", DynamicLocationDBID[i], DynamicLocationType[i], DynamicLocationMapIcon[i], DynamicLocationRadius[i], DynamicLocationName[i]);
        strcat(body, line, sizeof(body));
    }

    ShowPlayerDialog(playerid, DIALOG_LOC_LIST, DIALOG_STYLE_TABLIST_HEADERS, "Select Dynamic Location", body, "Select", "Back");
    return 1;
}

