+stock GetVehicleStorageLocationIndexByID(locationId)
+{
+    if (locationId <= 0) return -1;
+    for (new i = 0; i < VehicleStorageLocationCount; i++)
+    {
+        if (VehicleStorageLocationID[i] == locationId) return i;
+    }
+    return -1;
+}
+
+stock GetHouseVehicleStorageLocationIndex(houseCatalogId)
+{
+    if (houseCatalogId <= 0) return -1;
+    for (new i = 0; i < VehicleStorageLocationCount; i++)
+    {
+        if (!VehicleStorageEnabled[i]) continue;
+        if (strcmp(VehicleStorageType[i], "house", true) != 0) continue;
+        if (VehicleStorageReferenceID[i] == houseCatalogId) return i;
+    }
+    return -1;
+}
+
+stock IsPlayerNearVehicleStorageLocation(playerid, locationIndex)
+{
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount) return 0;
+    if (GetPlayerInterior(playerid) != VehicleStorageInterior[locationIndex]) return 0;
+    if (GetPlayerVirtualWorld(playerid) != VehicleStorageVirtualWorld[locationIndex]) return 0;
+    return IsPlayerInRangeOfPoint(playerid,
+        VehicleStorageInteractionRadius[locationIndex] + 1.0,
+        VehicleStorageInteractionX[locationIndex],
+        VehicleStorageInteractionY[locationIndex],
+        VehicleStorageInteractionZ[locationIndex]);
+}
+
+stock IsPlayerUsingCriticalCheckpoint(playerid)
+{
+    if (PlayerRace[playerid] != RACE_NONE) return 1;
+    if (PlayerWorking[playerid]) return 1;
+    if (PlayerFindingBank[playerid] || PlayerFindingHouse[playerid] || PlayerFindingBusiness[playerid] || PlayerFindingDealer[playerid]) return 1;
+    if (PlayerInsidePublicInteriorID[playerid] > 0 || GetPlayerPublicInteriorIndex(playerid) != -1) return 1;
+    return 0;
+}
+
+stock HideHouseVehicleStorageCheckpoint(playerid, disableCheckpoint = 1)
+{
+    if (PlayerHouseStorageCheckpoint[playerid] && disableCheckpoint) DisablePlayerCheckpoint(playerid);
+    PlayerHouseStorageCheckpoint[playerid] = 0;
+    PlayerHouseStorageLocationIndex[playerid] = -1;
+    return 1;
+}
+
+stock RefreshPlayerHouseVehicleStorageCheckpoint(playerid)
+{
+    if (!IsPlayerConnected(playerid) || !PlayerLoggedIn[playerid]) return 0;
+
+    if (IsPlayerUsingCriticalCheckpoint(playerid))
+    {
+        // Release ownership without disabling a checkpoint that may have just been replaced by a job/finder/service.
+        HideHouseVehicleStorageCheckpoint(playerid, 0);
+        return 0;
+    }
+
+    if (!VehicleStoragePolicyReady || !VehicleStorageLocationsReady ||
+        !VehicleStoragePolicyEnabled || !VehicleStorageHouseEnabled || PlayerHouseCatalogID[playerid] <= 0)
+    {
+        HideHouseVehicleStorageCheckpoint(playerid, 1);
+        return 0;
+    }
+
+    new locationIndex = GetHouseVehicleStorageLocationIndex(PlayerHouseCatalogID[playerid]);
+    if (locationIndex == -1)
+    {
+        HideHouseVehicleStorageCheckpoint(playerid, 1);
+        return 0;
+    }
+
+    if (GetPlayerInterior(playerid) != VehicleStorageInterior[locationIndex] ||
+        GetPlayerVirtualWorld(playerid) != VehicleStorageVirtualWorld[locationIndex])
+    {
+        HideHouseVehicleStorageCheckpoint(playerid, 1);
+        return 0;
+    }
+
+    new Float:distance = GetPlayerDistanceFromPoint(playerid,
+        VehicleStorageInteractionX[locationIndex],
+        VehicleStorageInteractionY[locationIndex],
+        VehicleStorageInteractionZ[locationIndex]);
+
+    if (distance <= VEHICLE_STORAGE_CHECKPOINT_DRAW_RADIUS)
+    {
+        if (!PlayerHouseStorageCheckpoint[playerid] || PlayerHouseStorageLocationIndex[playerid] != locationIndex)
+        {
+            SetPlayerCheckpoint(playerid,
+                VehicleStorageInteractionX[locationIndex],
+                VehicleStorageInteractionY[locationIndex],
+                VehicleStorageInteractionZ[locationIndex],
+                VehicleStorageInteractionRadius[locationIndex]);
+            PlayerHouseStorageCheckpoint[playerid] = 1;
+            PlayerHouseStorageLocationIndex[playerid] = locationIndex;
+        }
+        return 1;
+    }
+
+    HideHouseVehicleStorageCheckpoint(playerid, 1);
+    return 0;
+}
+
+public VehicleStorageCheckpointTick()
+{
+    for (new playerid = 0; playerid < MAX_PLAYERS; playerid++)
+    {
+        if (IsPlayerConnected(playerid) && PlayerLoggedIn[playerid]) RefreshPlayerHouseVehicleStorageCheckpoint(playerid);
+    }
+    return 1;
+}
+
+stock GetStoredVehicleCountAtLocation(playerid, locationId)
+{
+    new count = 0;
+    for (new i = 0; i < MAX_GARAGE_SLOTS; i++)
+    {
+        if (PlayerGarageDBID[playerid][i] > 0 && PlayerGarageStored[playerid][i] && PlayerGarageStorageLocationID[playerid][i] == locationId) count++;
+    }
+    return count;
+}
+
+stock HasStoredVehicleAtOwnedHouse(playerid)
+{
+    if (PlayerHouseStorageOperationPending[playerid]) return 1;
+    if (PlayerHouseCatalogID[playerid] <= 0) return 0;
+    new locationIndex = GetHouseVehicleStorageLocationIndex(PlayerHouseCatalogID[playerid]);
+    if (locationIndex == -1) return 0;
+    return GetStoredVehicleCountAtLocation(playerid, VehicleStorageLocationID[locationIndex]) > 0;
+}
+
+stock GetFreeStoredVehicleSlotAtLocation(playerid, locationIndex)
+{
+    if (locationIndex < 0 || locationIndex >= VehicleStorageLocationCount) return -1;
+    new capacity = VehicleStorageCapacity[locationIndex];
+    if (capacity < 1) return -1;
+    if (capacity > VehicleStorageMaxSlotsPerLocation && VehicleStorageMaxSlotsPerLocation > 0) capacity = VehicleStorageMaxSlotsPerLocation;
+
+    for (new storageSlot = 1; storageSlot <= capacity; storageSlot++)
+    {
+        new used = 0;
+        for (new i = 0; i < MAX_GARAGE_SLOTS; i++)
+        {
+            if (PlayerGarageStored[playerid][i] &&
+                PlayerGarageStorageLocationID[playerid][i] == VehicleStorageLocationID[locationIndex] &&
+                PlayerGarageStorageSlot[playerid][i] == storageSlot)
+            {
+                used = 1;
+                break;
+            }
+        }
+        if (!used) return storageSlot;
+    }
+    return -1;
+}
+
+stock HasOtherPlayerInVehicle(playerid, vehicleid)
+{
+    for (new i = 0; i < MAX_PLAYERS; i++)
+    {
+        if (i == playerid || !IsPlayerConnected(i)) continue;
+        if (IsPlayerInVehicle(i, vehicleid)) return 1;
+    }
+    return 0;
+}
