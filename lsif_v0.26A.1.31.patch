+    x = VehicleStorageSpawnX[locationIndex];
+    y = VehicleStorageSpawnY[locationIndex];
+    z = VehicleStorageSpawnZ[locationIndex];
+    a = VehicleStorageSpawnA[locationIndex];
+    return 1;
+}
